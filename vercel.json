{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2",
    "RAG_TOP_K": "3",
    "MIN_SIMILARITY": "0.30"
  }
}
