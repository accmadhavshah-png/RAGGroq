# Copy this file to .env and add your private Groq API key.
# Never commit .env or expose your key in screenshots.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# These settings preserve the main retrieval choices in Experiment 5.
KNOWLEDGE_BASE_DIR=knowledge_base
CHROMA_PATH=chroma_db
CHROMA_COLLECTION=experiment5_healthcare
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RAG_TOP_K=3
MIN_SIMILARITY=0.30

# Set to true for one startup to rebuild the index after replacing or editing documents.
# Set it back to false after the rebuild, otherwise it will rebuild at every new process start.
REBUILD_INDEX=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Vercel deployment (serverless)
# ---------------------------------------------------------------------------
# Run `python scripts/build_index.py` locally AFTER changing knowledge-base
# files, then `vercel deploy --prod`. GROQ_API_KEY must be set in the Vercel
# dashboard (do NOT commit it): Project Settings -> Environment Variables.
# See vercel.json and api/index.py.
